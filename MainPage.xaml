<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculatrice.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>

            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"
                MaximumDate="{Binding DateMax}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Calculer"
                        Command="{Binding CalculerCommand}"/>
                <Button Grid.Column="1" Text="Effacer"
                        Command="{Binding EffacerCommand}"/>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding ResultatVisible}"
                                 Spacing="6">
                <Label Text="{Binding Resultat}" FontSize="20"/>
                <Label Text="{Binding JoursRestants}" FontSize="16"/>
            </VerticalStackLayout>

            <Label Text="Historique" FontSize="18" FontAttributes="Bold"/>
            <Button Text="Vider l'historique"
                    Command="{Binding ViderHistoriqueCommand}"/>

            <CollectionView ItemsSource="{Binding Historique}"
                            HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}" Padding="0,4"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>